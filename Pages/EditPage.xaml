<Page x:Class="WpfApp1.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage">

    <StackPanel Height="auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Width="400" >
        <Button Style="{StaticResource MaterialDesignRaisedButton}" Click="BackButton_Click"
                Content="Вернуться"  Margin="15"/>
        <TextBox Width="auto" Margin="15"
                 materialDesign:HintAssist.Hint="Название"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Width="auto" Margin="15"
                 materialDesign:HintAssist.Hint="Компания"
                 Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Width="auto" Margin="15"
                 materialDesign:HintAssist.Hint="Зарплата"
                 Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Width="auto" Margin="15"
                 materialDesign:HintAssist.Hint="Город"
                 Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Width="auto" Margin="15"
                 Content="Активно?"
                 IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Style="{StaticResource MaterialDesignRaisedButton}" Click="AddButton_Click" Content="Изменить"  Margin="15"/>
    </StackPanel>
</Page>
